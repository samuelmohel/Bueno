# ─────────────────────────────────────────────────────────────────────────────
# Bueno Freight OS — environment
#
# Copy to .env and fill in. On the cPanel server this file belongs at
#   /home/<cpanel-user>/.env
# which is ABOVE the document root, so it can never be served over HTTP even if
# .htaccess is ignored. Never commit a filled-in copy.
#
#   chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Signs session tokens. Must be at least 32 characters, and unique to this
# deployment. The API refuses to start without it rather than fall back to a
# guessable default, because a predictable signing key lets anyone mint an
# administrator session.
#
# Generate with:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=e1cce5871b9b1f96e34e59d25e08169b6b9d698a764c534da14f7c4164d6554c

# "production" hides error detail from API responses and makes a failed
# database connection fatal instead of silently falling back to SQLite.
APP_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
#
# From cPanel → MySQL Databases. The user needs SELECT, INSERT, UPDATE, DELETE,
# CREATE, ALTER and INDEX (CREATE/ALTER/INDEX are used by migrations only).
#
# If DB_NAME and DB_USER are both unset, the API falls back to a local SQLite
# file — intended for development only. In production (APP_ENV=production) a
# MySQL connection failure returns HTTP 503 rather than quietly writing
# somewhere else, because a silent fallback means reads and writes land in
# different databases and records appear to vanish.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Application ──────────────────────────────────────────────────────────────

# Public base URL, used to build tracking links in outbound email.
APP_URL=https://360.specklessinnovations.com

# From address for transactional mail. Use a mailbox on your own domain, or
# messages will fail SPF and be treated as spam.
MAIL_FROM=dispatch@specklessinnovations.com

# ── Optional tuning ──────────────────────────────────────────────────────────

# Session lifetime. Sliding: it extends while the user is active.
# 43200 = 12 hours.
SESSION_TTL_SECONDS=43200

# Minimum password length enforced when a user sets a new one.
MIN_PASSWORD_LENGTH=8

# Rate limits.
#   LOGIN_RATE_IP  sign-in attempts per source address per 5 minutes
#   LOGIN_RATE_ID  sign-in attempts per account per 5 minutes
#   ENQUIRY_RATE   public enquiry submissions per address per hour
#   TRACK_RATE     public tracking lookups per address per 5 minutes
#   GPS_RATE       position reports per trip per minute
#   MAIL_RATE      dispatch emails per user per hour
LOGIN_RATE_IP=20
LOGIN_RATE_ID=10
ENQUIRY_RATE=5
TRACK_RATE=30
GPS_RATE=60
MAIL_RATE=30

# Cross-origin access. Leave empty for same-origin only, which is correct when
# the site and API share a host — as they do here. Set it only if you serve the
# front end from a different domain; it was previously "*", which let any
# website on the internet read your operational data through a signed-in
# employee's browser.
ALLOWED_ORIGINS=

# Set to true only when the server sits behind a proxy or CDN that sets
# X-Forwarded-For. Otherwise the header is client-controlled and rate limits
# become trivially bypassable.
TRUST_PROXY=false

# ── Development only ─────────────────────────────────────────────────────────
# Path to the SQLite file used when no MySQL credentials are configured.
# SQLITE_PATH=/absolute/path/to/bueno.sqlite
