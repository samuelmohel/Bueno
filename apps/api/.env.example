# Database — PostgreSQL production configuration
DATABASE_URL="postgresql://bueno:bueno123@localhost:5432/bueno_db?schema=public"

# Redis Cache & Real-Time Gateway
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=bueno-prod-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=bueno-prod-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# App
PORT=3001
NODE_ENV=production
API_PREFIX=api/v1

# Paystack (Optional — offline/invoice billing is default)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
MOBILE_URL=exp://localhost:8081
