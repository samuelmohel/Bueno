generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─── Enums ────────────────────────────────────────────────────────────────────
// NOTE: SQLite has no native enum support in Prisma, so role/status/type fields
// below are plain String columns. Allowed values are defined and validated in
// src/common/enums.ts and used the same way the old Prisma enums were used.
//
// UserRole:        ADMIN | HEAD_OF_OPERATIONS | CARGO_OFFICER | CUSTOMER | DRIVER
// WagonType:       OPEN_GONDOLA | FLAT | COVERED_VAN | CONTAINER_FLAT | HOPPER
// AssetStatus:     AVAILABLE | MAINTENANCE | IN_USE
// AssetCondition:  EXCELLENT | GOOD | FAIR
// BookingStatus:   PENDING | BOOKING_CONFIRMED | COORDINATING | WAGON_ALLOCATED |
//                  CARGO_AT_TERMINAL | LOADING_IN_PROGRESS | DEPARTED | IN_TRANSIT |
//                  ARRIVED_DESTINATION | UNLOADING | READY_FOR_COLLECTION | COMPLETED | CANCELLED
// PaymentStatus:   PENDING | PAID | FAILED
// MessageType:     TEXT | IMAGE | SYSTEM
// CargoUnit:       BAGS | TONNES | UNITS

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  refreshToken String?
  avatar       String?
  phone        String?
  role         String
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  bookings        Booking[]      @relation("UserBookings")
  sentMessages    ChatMessage[]  @relation("UserSentMessages")
  notifications   Notification[]
  driver          Driver?
  loadedItems     CargoItem[]    @relation("CargoItemLoadedBy")
  unloadedItems   CargoItem[]    @relation("CargoItemUnloadedBy")
  officerTargets  CargoOfficerTarget[] @relation("UserOfficerTargets")
  wagonAudits     WagonUnloadAudit[]   @relation("WagonAuditUnloadedBy")
}

model Driver {
  id            String       @id @default(cuid())
  userId        String       @unique
  licenseNumber String?
  licenseExpiry DateTime?
  user          User         @relation(fields: [userId], references: [id])
  locomotives   Locomotive[]
}

// ─── Routes & Pricing ─────────────────────────────────────────────────────────

model Route {
  id                  String         @id @default(cuid())
  routeName           String
  originTerminal      String
  destinationTerminal String
  distanceKm          Float
  estimatedDurationHr Float
  active              Boolean        @default(true)
  bookings            Booking[]
  pricing             RoutePricing[]
}

model RoutePricing {
  id               String   @id @default(cuid())
  routeId          String
  pricePerWagonNgn Int
  fuelSurchargePct Int
  active           Boolean  @default(true)
  effectiveFrom    DateTime @default(now())
  route            Route    @relation(fields: [routeId], references: [id])
}

// ─── Cargo ────────────────────────────────────────────────────────────────────

model CargoType {
  id                    String     @id @default(cuid())
  name                  String     @unique
  densityTPerM3         Float?
  defaultWagonCapacityT Int?
  wagonType             String?
  requiresSpecialWagon  Boolean?   @default(false)
  handlingNotes         String?
  active                Boolean    @default(true)
  bookings              Booking[]
}

// ─── Booking (= Trip) ──────────────────────────────────────────────────────────

model Booking {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  bookingCode String   @unique @default(cuid())

  customerId  String
  routeId     String
  cargoTypeId String

  cargoWeightTonnes Float
  wagonsRequired    Int
  locosRequired     Int
  totalAmountNgn    Float

  bookingStatus String @default("PENDING")
  paymentStatus String @default("PENDING")

  paystackReference String? @unique
  paystackVerified  Boolean @default(false)

  trainNumber         String?
  specialInstructions String?
  dropOffDate         DateTime?
  destinationContact  String?
  destinationPhone    String?

  customer         User              @relation("UserBookings", fields: [customerId], references: [id])
  route            Route             @relation(fields: [routeId], references: [id])
  cargoType        CargoType         @relation(fields: [cargoTypeId], references: [id])
  wagonAllocations WagonAllocation[]
  events           BookingEvent[]
  chatMessages     ChatMessage[]
}

model BookingEvent {
  id          String   @id @default(cuid())
  bookingId   String
  status      String
  title       String
  description String?
  triggeredBy String?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model ChatMessage {
  id            String   @id @default(cuid())
  bookingId     String
  senderId      String
  content       String
  messageType   String   @default("TEXT")
  attachmentUrl String?
  readAt        DateTime?
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  sender        User     @relation("UserSentMessages", fields: [senderId], references: [id])
}

// ─── Fleet ────────────────────────────────────────────────────────────────────

model Wagon {
  id              String   @id @default(cuid())
  serialNumber    String   @unique
  wagonType       String
  capacityTonnes  Int
  status          String   @default("AVAILABLE")
  condition       String   @default("GOOD")
  manufactureYear Int
  totalTrips      Int      @default(0)
  notes           String?
  lastInspectedAt DateTime?
  nextServiceDue  DateTime?
  createdAt       DateTime @default(now())

  allocations WagonAllocation[]
  inspections Inspection[]
}

model Locomotive {
  id               String   @id @default(cuid())
  serialNumber     String   @unique
  model            String
  manufacturer     String
  maxWagonCapacity Int
  fuelLevelPercent Int
  engineHours      Int
  status           String   @default("AVAILABLE")
  condition        String   @default("GOOD")
  currentLat       Float?
  currentLng       Float?
  assignedDriverId String?
  lastInspectedAt  DateTime?
  lastFuelledAt    DateTime?
  nextServiceDue   DateTime?
  createdAt        DateTime @default(now())
  notes            String?

  assignedDriver  Driver?               @relation(fields: [assignedDriverId], references: [id])
  allocations     WagonAllocation[]
  inspections     Inspection[]
  fuelLogs        FuelLog[]
  locationHistory LocoLocationHistory[]
}

model WagonAllocation {
  id          String    @id @default(cuid())
  bookingId   String
  wagonId     String
  locoId      String?
  allocatedBy String?
  allocatedAt DateTime  @default(now())
  departedAt  DateTime?
  arrivedAt   DateTime?

  booking         Booking          @relation(fields: [bookingId], references: [id])
  wagon           Wagon            @relation(fields: [wagonId], references: [id])
  locomotive      Locomotive?      @relation(fields: [locoId], references: [id])
  cargoItems      CargoItem[]
  feederTruckLogs FeederTruckLog[]
  unloadAudit     WagonUnloadAudit?
}

// ─── Cargo Inventory ────────────────────────────────────────────────────────
// The core "one record, used twice" model: created at loading, referenced
// again at unloading against the SAME wagon allocation. Any gap between
// loadedQty and unloadedQty is a discrepancy, visible immediately.

model CargoItem {
  id                String   @id @default(cuid())
  wagonAllocationId String

  description  String
  customerRef  String?
  unit         String   @default("BAGS")

  loadedQty    Float
  loadedById   String?
  loadedAt     DateTime?

  unloadedQty  Float?
  unloadedById String?
  unloadedAt   DateTime?

  damaged      Boolean  @default(false)
  notes        String?

  createdAt DateTime @default(now())

  wagonAllocation WagonAllocation @relation(fields: [wagonAllocationId], references: [id])
  loadedBy        User?           @relation("CargoItemLoadedBy", fields: [loadedById], references: [id])
  unloadedBy      User?           @relation("CargoItemUnloadedBy", fields: [unloadedById], references: [id])
}

model Inspection {
  id            String   @id @default(cuid())
  assetType     String // "WAGON" | "LOCOMOTIVE"
  wagonId       String?
  locoId        String?
  inspectedBy   String?
  checklistJson String?
  passed        Boolean
  issuesFound   String?
  inspectedAt   DateTime @default(now())

  wagon Wagon?      @relation(fields: [wagonId], references: [id])
  loco  Locomotive? @relation(fields: [locoId], references: [id])
}

model FuelLog {
  id              String     @id @default(cuid())
  locoId          String
  loggedBy        String?
  litresAdded     Float
  costNgn         Float
  fuelLevelBefore Float
  fuelLevelAfter  Float
  notes           String?
  loggedAt        DateTime   @default(now())
  locomotive      Locomotive @relation(fields: [locoId], references: [id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  bookingId String?
  data      String?
  read      DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

// ─── Location Tracking ────────────────────────────────────────────────────────

model LocoLocationHistory {
  id        String   @id @default(cuid())
  locoId    String
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())
  loco      Locomotive @relation(fields: [locoId], references: [id])
}

// ─── Feeder Truck Manifest (Handwritten Field Spec) ──────────────────────────

model FeederTruckLog {
  id                String          @id @default(cuid())
  wagonAllocationId String
  truckRegNo        String
  driverName        String
  driverPhone       String
  transporterName   String
  loadingSource     String?         // e.g. "Silo 4", "Plant Bay B"
  quantityLoaded    Float
  unit              String          @default("BAGS")
  startTime         DateTime
  endTime           DateTime?
  createdAt         DateTime        @default(now())

  wagonAllocation   WagonAllocation @relation(fields: [wagonAllocationId], references: [id])
}

// ─── Granular Unloading & Wagon Complaint Audit (Field Spec) ──────────────────

model WagonUnloadAudit {
  id                String          @id @default(cuid())
  wagonAllocationId String          @unique
  startTime         DateTime
  endTime           DateTime?
  
  intactCount       Float           @default(0)
  damagedCount      Float           @default(0)
  burstBagCount     Float           @default(0)
  
  hasComplaint      Boolean         @default(false)
  complaintType     String?         // "ROOF_LEAK", "MECHANICAL", "SEAL_BROKEN", "DIRTY_INTERIOR"
  complaintDetails  String?
  photoUrls         String?         // JSON array of photo URLs
  unloadedById      String?
  createdAt         DateTime        @default(now())

  wagonAllocation   WagonAllocation @relation(fields: [wagonAllocationId], references: [id])
  unloadedBy        User?           @relation("WagonAuditUnloadedBy", fields: [unloadedById], references: [id])
}

// ─── Operational Budget & KPI Targets (Mr. Niyi Spec) ─────────────────────────

model TerminalMonthlyBudget {
  id              String   @id @default(cuid())
  year            Int
  month           Int      // 1 - 12
  stationCode     String   // "EWK", "MNY", "APT"
  targetTrains    Int
  targetTonnage   Float
  targetRevenue   Float
  createdAt       DateTime @default(now())

  officerTargets  CargoOfficerTarget[]
}

model CargoOfficerTarget {
  id              String   @id @default(cuid())
  budgetId        String
  officerId       String
  targetTrains    Int
  achievedTrains  Int      @default(0)
  ratingScore     Float?   // e.g. 94.5%
  budget          TerminalMonthlyBudget @relation(fields: [budgetId], references: [id])
  officer         User                  @relation("UserOfficerTargets", fields: [officerId], references: [id])
}
