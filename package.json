{
  "name": "bueno-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "npx turbo run build",
    "db:init": "cd apps/api && node prisma/init-db.js",
    "db:seed": "cd apps/api && npx ts-node prisma/seed.ts",
    "db:reset": "npm run db:init && npm run db:seed",
    "db:studio": "cd apps/api && npx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
